  "dsl": {
    "closedOperators": [
      "true",
      "false",
      "ref",
      "all",
      "any",
      "not",
      "role_in",
      "fact_eq",
      "fact_in",
      "date_lte",
      "date_gte",
      "owner_dispatch",
      "register_readable",
      "dependency_exists",
      "dependency_field_eq",
      "dependency_link_eq",
      "source_dependency_link_eq",
      "dependency_register_readable"
    ],
    "all": "all args must evaluate true; an empty args list is invalid",
    "any": "at least one arg must evaluate true; an empty args list is invalid",
    "ref": "resolve only a named predicate in this artifact; cycles fail",
    "role_in": "actor.role must be a member of the named frozen role set",
    "fact_eq": "exact equality unless the path is explicitly marked normalized",
    "fact_in": "exact membership",
    "date_lte": "ISO date at leftPath is on or before rightValue",
    "date_gte": "ISO date at leftPath is on or after rightValue",
    "owner_dispatch": "evaluate exactly one exact ownerType case; missing or unknown ownerType is false",
    "register_readable": "recursively evaluate the named register predicate against the referenced row and same actor",
    "dependency_exists": "within the source tenant, resolve the named materialized dependency and require the declared table; zero matches evaluate false and multiple matches are a conformance hard failure",
    "dependency_field_eq": "within the source tenant, resolve exactly one named materialized dependency and compare its declared field to the literal value; zero matches evaluate false and multiple matches are a conformance hard failure",
    "dependency_link_eq": "within the source tenant, resolve both named materialized dependencies and require exact equality between the declared fields; a missing dependency evaluates false and duplicate resolution is a conformance hard failure",
    "source_dependency_link_eq": "within the source tenant, resolve exactly one named materialized dependency and require exact equality between a source-row path and the dependency identity or declared field; a missing dependency evaluates false and duplicate resolution is a conformance hard failure",
    "dependency_register_readable": "within the source tenant, resolve exactly one materialized dependency, require its declared register, and recursively evaluate that register's full readableWhen predicate for the same actor; a missing dependency or false nested predicate evaluates false and duplicate resolution is a conformance hard failure",
    "baselineDependencyRule": "Every unmutated Comms baseline declares exactly one owner, thread, Mission anchor, and provenance row. Missing baseline rows are fixture-conformance failures; deliberate omit_dependency counterfactuals instead exercise earned authorization denials.",
    "missingFact": "false",
    "unknownOperator": "fail_closed",
    "unknownRegister": "fail_closed",
    "unknownOwnerType": "fail_closed",
    "noImplicitCoercion": true
  },
